# ---------------------------------------------------------------------------
# Board Meeting Management System — environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# --- Database (Microsoft SQL Server via Prisma) ----------------------------
# SQL Server Express / Developer (TCP enabled):
#   sqlserver://HOST:1433;database=board_meetings;user=sa;password=Your_Strong_Pass1;trustServerCertificate=true;encrypt=true
# Azure SQL:
#   sqlserver://your-server.database.windows.net:1433;database=board_meetings;user=admin@your-server;password=...;encrypt=true;trustServerCertificate=false
# Windows integrated auth (named instance) — requires extra setup; TCP + SQL auth is simplest.
DATABASE_URL="sqlserver://localhost:1433;database=board_meetings;user=sa;password=Your_Strong_Pass1;trustServerCertificate=true;encrypt=true"

# --- Session signing -------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Session lifetime in hours
SESSION_TTL_HOURS="12"

# --- File storage ----------------------------------------------------------
# "local" stores files under ./storage (dev). "s3" uses the S3 settings below.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# S3 / MinIO (only used when STORAGE_DRIVER=s3) — wire in lib/storage.ts
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="board-papers"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Public app URL ----------------------------------------------------------
# Used to build absolute links in outgoing emails (e.g. the chairman's approval link).
APP_URL="http://localhost:3000"

# --- Email notifications (optional) ----------------------------------------
# "log" writes notifications to the DB + console (default). "smtp" sends mail
# for real via nodemailer — works with Gmail, Outlook/Microsoft 365, or any SMTP account.
#
# Gmail: smtp.gmail.com, port 587, an "App password" (not your normal password) as SMTP_PASS.
# Outlook/Microsoft 365: smtp.office365.com, port 587, your mailbox password (or app password if MFA is on).
NOTIFY_DRIVER="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Board Secretariat <board@yourcompany.in>"

# --- Azure AD SSO (Phase 4 — optional) -------------------------------------
# When all three are set, the login page shows a "Sign in with Microsoft" option.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Chatbot over minutes (Phase 5 — optional) -----------------------------
# When unset, the assistant answers with full-text search over minutes/resolutions.
# When set, answers are summarised by Claude. Model: claude-opus-4-8 (latest).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# --- Zoom meetings (Server-to-Server OAuth REST API) -----------------------
# Optional. When set, Video/Hybrid meetings get a real Zoom meeting created
# automatically (join link stored on the meeting). Meetings happen in Zoom's
# own app/web client, not embedded in this app. Create a "Server-to-Server
# OAuth" app (NOT "Video SDK"/"Meeting SDK") at marketplace.zoom.us, and add
# scopes: meeting:write:meeting:admin, meeting:update:meeting:admin,
# meeting:delete:meeting:admin (confirm exact names in the app's scope picker).
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# --- Zoom Meeting SDK (embeds the call inside the Meeting Room page) --------
# Optional, and SEPARATE from the three values above. When set, a Video/Hybrid
# meeting's video renders directly next to the agenda and voting panel instead
# of sending directors out to the Zoom app. Create a "General App" at
# marketplace.zoom.us, go to Features → Embed and toggle "Meeting SDK" on, then
# copy the Client ID / Client Secret from Basic Information.
# Everyone joins as a participant (the Zoom meeting is created with
# join_before_host), so no ZAK token or host licence is involved.
ZOOM_SDK_CLIENT_ID=""
ZOOM_SDK_CLIENT_SECRET=""

# --- Bootstrap / sample admin ---------------------------------------------
# Auto-created on first login if it doesn't exist, so you can sign in before
# seeding. Only created when missing — changing the password in the UI sticks.
# Change these (or remove the account) before production.
BOOTSTRAP_ADMIN_EMAIL="admin@company.in"
BOOTSTRAP_ADMIN_PASSWORD="Passw0rd!"

# --- Company / compliance profile -----------------------------------------
COMPANY_NAME="Your Company Private Limited"
COMPANY_IS_LISTED="false"
